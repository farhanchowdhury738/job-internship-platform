
@model Job.Models.Login

@{
    ViewData["Title"] = "Login";
}

<!-- Login Page Container -->
<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5" style="padding-top: 90px !important;">
    <!-- Login Card -->
    <div class="card border-0 shadow-sm rounded-4 w-100" style="max-width: 500px;">
        <div class="card-body p-4 p-md-5">
            <!-- Login Form -->
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <fieldset class="border rounded-4 p-3 p-md-4">
                    <legend class="float-none w-auto px-2 fw-bold fs-3">Login</legend>
                    <p class="text-secondary text-center mb-4">Login to your CareerBridge account</p>

                    <!-- Validation Message -->
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <!-- Email -->
                    <div class="mb-3">
                        <input asp-for="Email" class="form-control border-0 border-bottom border-2 rounded-0 shadow-none bg-transparent px-2 py-1" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <input asp-for="Password" type="password" class="form-control border-0 border-bottom border-2 rounded-0 shadow-none bg-transparent px-2 py-1" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Login Button -->
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary rounded-3 px-5 py-2 fw-bold">Login</button>
                    </div>

                    <!-- Register Link -->
                    <div class="text-center mt-4">
                        <span class="text-secondary">Don't have an account?</span>
                        <a asp-controller="Account" asp-action="Register" class="text-primary text-decoration-none fw-semibold">Sign up</a>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>

<!-- Client Side Validation -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
