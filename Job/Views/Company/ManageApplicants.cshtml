@using Job.Models

@{
    ViewData["Title"] = "Manage Applicants";

    var jobPosts = ViewBag.JobPosts as List<CompanyJobPost>
                   ?? new List<CompanyJobPost>();

    int totalApplicants = ViewBag.TotalApplicants ?? 0;
    int totalPosts = ViewBag.TotalPosts ?? 0;
}

<section class="applicants-section">
    <div class="container py-4">

        <!-- Back Button -->
        <div class="mb-3">
            <a asp-controller="Company" asp-action="Dashboard"
               class="btn btn-outline-secondary rounded-pill px-4 mt-2">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Dashboard
            </a>
        </div>

        <!-- Page Header -->
        <div class="mb-4">
            </span>
            <h2 class="fw-bold text-dark mt-3 mb-1">Manage Applicants</h2>
        </div>

        <!-- Summary Cards -->
        <div class="row g-3 mb-4">

            <!-- Total Applicants -->
            <div class="col-6 col-md-3">
                <div class="card applicant-card border-0 rounded-4 shadow-sm">
                    <div class="card-body px-3 py-2">
                        <h4 class="fw-bold text-primary mb-0">@totalApplicants</h4>
                        <p class="text-muted small mb-0">Total Applicants</p>
                    </div>
                </div>
            </div>

            <!-- Total Job Posts -->
            <div class="col-6 col-md-3">
                <div class="card applicant-card border-0 rounded-4 shadow-sm">
                    <div class="card-body px-3 py-2">
                        <h4 class="fw-bold text-success mb-0">@totalPosts</h4>
                        <p class="text-muted small mb-0">Total Job Posts</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Job Posts Section Header -->
        <div class="mb-3">
            <h5 class="fw-bold text-dark mb-1">Your Job Posts</h5>
        </div>

        <!-- Check Whether Job Posts Exist -->
        @if (!jobPosts.Any())
        {
            <!-- Empty State -->
            <div class="card applicant-card border-0 rounded-4 shadow-sm text-center p-5">
                <div class="text-muted mb-3">
                    <i class="bi bi-briefcase fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark">No Job Posts Yet</h5>
                <p class="text-muted small mb-0">
                    You haven't created any job posts yet.
                </p>
            </div>
        }
        else
        {
            <!-- Job Post Cards -->
            <div class="row g-3">

                @foreach (var post in jobPosts)
                {
                    <div class="col-12 col-lg-6">

                        <div class="card applicant-card border-0 rounded-4 shadow-sm h-100">

                            <div class="card-body p-3 p-md-4">

                                <!-- Job Title and Status -->
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                    <h6 class="fw-bold text-dark mb-0">
                                        @post.JobTitle
                                    </h6>

                                    <span class="badge rounded-pill bg-@(post.PostStatus == "published" ? "success" : post.PostStatus == "closed" ? "danger" : "warning")">
                                        @post.PostStatus
                                    </span>
                                </div>

                                <!-- Applicant Status Summary -->
                                <div class="d-flex flex-wrap gap-2 mb-3">

                                    <span class="badge bg-secondary rounded-pill">
                                        Total: @post.Applications.Count
                                    </span>

                                    <span class="badge bg-light text-dark border rounded-pill">
                                        Submitted: @post.Applications.Count(a => a.ApplicationStatus == "submitted")
                                    </span>

                                    <span class="badge bg-info-subtle text-info rounded-pill">
                                        Under Review: @post.Applications.Count(a => a.ApplicationStatus == "under_review")
                                    </span>

                                    <span class="badge bg-primary-subtle text-primary rounded-pill">
                                        Shortlisted: @post.Applications.Count(a => a.ApplicationStatus == "shortlisted")
                                    </span>

                                    <span class="badge bg-warning-subtle text-dark rounded-pill">
                                        Interview: @post.Applications.Count(a => a.ApplicationStatus == "interview")
                                    </span>

                                    <span class="badge bg-success-subtle text-success rounded-pill">
                                        Selected: @post.Applications.Count(a => a.ApplicationStatus == "selected")
                                    </span>

                                    <span class="badge bg-danger rounded-pill">
                                        Rejected: @post.Applications.Count(a => a.ApplicationStatus == "rejected")
                                    </span>

                                </div>

                                <!-- Dotted Divider -->
                                <div class="dotted-divider my-3"></div>

                                <!-- View Details Button -->
                                <div class="text-end">
                                    <a asp-controller="Company"
                                       asp-action="ViewJobApplicants"
                                       asp-route-id="@post.JobPostId"
                                       class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                        View Details
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>

                            </div>
                        </div>

                    </div>
                }

            </div>
        }

    </div>
</section>

<style>
    /* Background */
    .applicants-section {
        width: 100%;
        min-height: 100vh;
        background-color: #E5E7F2;
    }

    /* Cards */
    .applicant-card {
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    /* Gradient Top Border */
    .applicant-card::before {
        content: "";
        display: block;
        height: 5px;
        background: linear-gradient(90deg, #6c4bff, #00c2a8);
    }

    /* Hover Animation */
    .applicant-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(108, 75, 255, 0.18) !important;
    }

    /* Dotted Divider */
    .dotted-divider {
        border-top: 2px dashed #c5c7d8;
    }
</style>