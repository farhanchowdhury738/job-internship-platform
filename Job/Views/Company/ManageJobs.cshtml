
@model Job.Models.CompanyJobPost

@{
    ViewData["Title"] = "Manage Job Posts";
    var jobPosts = ViewBag.JobPosts as IEnumerable<Job.Models.CompanyJobPost> ?? Enumerable.Empty<Job.Models.CompanyJobPost>();
    bool isEditing = Model.JobPostId > 0;
}

<section class="jobs-manage-section">
    <div class="container py-4">

        <!-- Back Button -->
        <div class="mb-3">
            <a asp-controller="Company" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        <!-- Page Header -->
        <div class="mb-3">
            <h2 class="fw-bold text-dark mt-3 mb-1">Manage Job Posts</h2>
        </div>

        <!-- Success Message -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show rounded-3">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Create / Edit Form -->
        <div class="card post-card border-0 rounded-4 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">

                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-@(isEditing ? "pencil-square" : "plus-circle") text-primary me-2"></i>
                    @(isEditing ? "Update Job Post" : "Create New Job Post")
                </h5>

                <form asp-controller="Company" asp-action="ManageJobs" method="post">
                    <input type="hidden" asp-for="JobPostId" />

                    <!-- First Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="JobTitle" class="form-label fw-semibold small">Job Title</label>
                            <input asp-for="JobTitle" class="form-control form-control-sm" placeholder="Enter job title" />
                            <span asp-validation-for="JobTitle" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold small">Category</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.JobCategories" class="form-select form-select-sm">
                                <option value="">Select Category</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="JobType" class="form-label fw-semibold small">Job Type</label>
                            <select asp-for="JobType" class="form-select form-select-sm">
                                <option value="">Select Job Type</option>
                                <option value="full_time">Full Time</option>
                                <option value="internship">Internship</option>
                            </select>
                            <span asp-validation-for="JobType" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Second Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Vacancy" class="form-label fw-semibold small">Vacancy</label>
                            <input asp-for="Vacancy" type="number" min="1" class="form-control form-control-sm" placeholder="Number of vacancies" />
                            <span asp-validation-for="Vacancy" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Location" class="form-label fw-semibold small">Location</label>
                            <input asp-for="Location" class="form-control form-control-sm" placeholder="Enter location" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Salary" class="form-label fw-semibold small">Salary</label>
                            <input asp-for="Salary" class="form-control form-control-sm" placeholder="e.g. 25000 - 35000 BDT" />
                            <span asp-validation-for="Salary" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Third Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="ExperienceRequired" class="form-label fw-semibold small">Experience Required</label>
                            <input asp-for="ExperienceRequired" class="form-control form-control-sm" placeholder="e.g. 1-2 Years / Fresher" />
                            <span asp-validation-for="ExperienceRequired" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ApplicationDeadline" class="form-label fw-semibold small">Application Deadline</label>
                            <input asp-for="ApplicationDeadline"
                               type="date"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control form-control-sm" />
                            <span asp-validation-for="ApplicationDeadline" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PostStatus" class="form-label fw-semibold small">Post Status</label>
                            <select asp-for="PostStatus" class="form-select form-select-sm">
                                <option value="draft">Draft</option>
                                <option value="published">Published</option>
                                <option value="closed">Closed</option>
                            </select>
                            <span asp-validation-for="PostStatus" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Job Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small">Job Description</label>
                        <textarea asp-for="Description" class="form-control form-control-sm" rows="3" placeholder="Write job description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">
                            <i class="bi @(isEditing ? "bi-check-lg" : "bi-plus-lg") me-1"></i>
                            @(isEditing ? "Update Post" : "Create Post")
                        </button>

                        @if (isEditing)
                        {
                            <a asp-controller="Company" asp-action="ManageJobs" class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                                Cancel
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>

        <!-- My Job Posts -->
        <div class="mb-3">
            <h5 class="fw-bold text-dark mb-1">My Job Posts</h5>
        </div>

        @if (!jobPosts.Any())
        {
            <!-- Empty State -->
            <div class="card post-card border-0 rounded-4 shadow-sm text-center p-4">
                <i class="bi bi-briefcase fs-1 text-muted mb-2"></i>
                <h5 class="fw-bold">No Records Found</h5>
                <p class="text-muted small mb-0">No job posts available. Create your first job post!</p>
            </div>
        }
        else
        {
            <!-- Job Post Cards -->
            <div class="row g-3">
                @foreach (var post in jobPosts)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card post-card border-0 rounded-4 shadow-sm h-100">
                            <div class="card-body p-3 d-flex flex-column">

                                <h6 class="fw-bold text-dark mb-2">@post.JobTitle</h6>

                                <p class="text-muted small mb-2">
                                    <i class="bi bi-briefcase me-1"></i>
                                    @post.JobType.Replace("_", " ")
                                </p>

                                <p class="text-muted small mb-3">
                                    <i class="bi bi-geo-alt me-1"></i> @post.Location
                                </p>

                                <div class="dotted-divider pt-2 mb-3">
                                    <span class="badge rounded-pill bg-@(post.PostStatus == "published" ? "success" : post.PostStatus == "closed" ? "danger" : "warning")">
                                        @post.PostStatus
                                    </span>
                                </div>

                                <!-- Edit and Delete -->
                                <div class="d-flex gap-2 mt-auto">
                                    <a asp-controller="Company" asp-action="ManageJobs" asp-route-editId="@post.JobPostId"
                                       class="btn btn-outline-primary btn-sm rounded-pill flex-fill">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>

                                    <form asp-controller="Company" asp-action="DeleteJobPost" asp-route-id="@post.JobPostId"
                                          method="post" class="flex-fill"
                                          onsubmit="return confirm('Are you sure you want to delete this job post?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

<style>
    .jobs-manage-section {
        width: 100%;
        min-height: 100vh;
        background-color: #E5E7F2;
    }

    .post-card {
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .post-card::before {
        content: "";
        display: block;
        height: 4px;
        background: linear-gradient(90deg, #6c4bff, #00c2a8);
    }

    .post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(108, 75, 255, 0.16) !important;
    }

    .dotted-divider {
        border-top: 2px dashed #c5c7d8;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
