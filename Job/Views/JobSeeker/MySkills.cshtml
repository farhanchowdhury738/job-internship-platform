
@model List<JobSeekerSkill>

@{
    ViewData["Title"] = "My Skills";
    var categories = Model.GroupBy(s => s.CategoryName).OrderBy(g => g.Key).ToList();
    int totalSkills = Model.Count;
    int totalCategories = categories.Count;
}

<style>
    .skills-page { min-height:100vh; background:#E5E7F2; }
    .skills-card { position:relative; overflow:hidden; border:0; border-radius:16px; transition:.3s; }
    .skills-card::before { content:""; display:block; height:4px; background:linear-gradient(90deg,#6c4bff,#00c2a8); }
    .skills-card:hover { transform:translateY(-4px); box-shadow:0 10px 22px rgba(108,75,255,.15)!important; }
    .skills-divider { border-top:2px dashed #c5c7d8; }
</style>

<div class="skills-page py-3">
    <div class="container">

        <!-- Back Button -->
        <a asp-controller="JobSeeker" asp-action="Dashboard"
           class="btn btn-outline-secondary rounded-pill px-4 mt-2 mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>

        <!-- Page Header -->
        <div class="mb-3">
            <h4 class="fw-bold mb-1">Skill Lists</h4>
        </div>

        <!-- Notifications -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 py-2">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card skills-card shadow-sm h-100">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                            <i class="bi bi-tools fs-5"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">@totalSkills</h4>
                            <small class="text-muted">Total Skills</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card skills-card shadow-sm h-100">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-2">
                            <i class="bi bi-collection fs-5"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">@totalCategories</h4>
                            <small class="text-muted">Categories</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Add / Edit Form -->
        <div class="card skills-card shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <h6 class="fw-bold mb-1" id="formTitle">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Add New Skills
                </h6>

                <form asp-controller="JobSeeker" asp-action="AddSkills"
                      method="post" id="skillForm">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="oldCategoryName" id="oldCategoryName" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category Name</label>
                        <input type="text" name="categoryName" id="categoryName"
                               class="form-control form-control-sm rounded-3"
                               placeholder="e.g. Programming Languages"
                               maxlength="100" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Skill Names</label>
                        <textarea name="skillNames" id="skillNames"
                                  class="form-control form-control-sm rounded-3"
                                  rows="3" placeholder="PHP, JavaScript, Python, C++"
                                  required></textarea>
                        <small class="text-muted">Separate multiple skills using commas (,).</small>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4" id="submitBtn">
                            <i class="bi bi-plus-lg me-1"></i>Add Skills
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4 d-none"
                                id="cancelEditBtn" onclick="resetSkillForm()">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Skills List -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">My Skill Categories</h6>
            <span class="badge bg-primary rounded-pill">@totalCategories Categories</span>
        </div>

        @if (!categories.Any())
        {
            <div class="card skills-card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-tools display-5 text-muted"></i>
                    <h6 class="fw-bold mt-3">No Skills Added Yet</h6>
                    <p class="text-muted small mb-0">Start adding your professional skills using the form above.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var category in categories)
                {
                    var skillList = category.Select(s => s.SkillName).ToList();

                    <div class="col-12 col-sm-4 col-lg-3">
                        <div class="card skills-card shadow-sm h-100">
                            <div class="card-body p-3">
                                <!-- Category Header -->
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                    <h6 class="fw-bold mb-0 text-break">
                                        <i class="bi bi-folder2-open text-primary me-2"></i>@category.Key
                                    </h6>
                                    <div class="d-flex gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-sm btn-light text-primary rounded-3"
                                                title="Edit Category" onclick="editCategory(this)"
                                                data-category="@category.Key"
                                                data-skills="@string.Join(", ", skillList)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <form asp-controller="JobSeeker" asp-action="DeleteSkills"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this entire skill category?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="categoryName" value="@category.Key" />
                                            <button type="submit" class="btn btn-sm btn-light text-danger rounded-3"
                                                    title="Delete Category">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="skills-divider mb-3"></div>

                                <!-- Skills -->
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var skill in category)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-medium">
                                            @skill.SkillName
                                        </span>
                                    }
                                </div>

                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="bi bi-list-check me-1"></i>@skillList.Count Skills
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Edit Form Script -->
<script>
    function editCategory(button) {
        const category = button.dataset.category;
        const skills = button.dataset.skills;
        const form = document.getElementById("skillForm");

        form.action = '@Url.Action("EditSkills", "JobSeeker")';
        document.getElementById("oldCategoryName").value = category;
        document.getElementById("categoryName").value = category;
        document.getElementById("skillNames").value = skills;
        document.getElementById("formTitle").innerHTML =
            '<i class="bi bi-pencil-square text-primary me-2"></i>Edit Skill Category';
        document.getElementById("submitBtn").innerHTML =
            '<i class="bi bi-check-lg me-1"></i>Update Skills';
        document.getElementById("cancelEditBtn").classList.remove("d-none");
        document.getElementById("categoryName").focus();
        window.scrollTo({ top:0, behavior:"smooth" });
    }

    function resetSkillForm() {
        const form = document.getElementById("skillForm");
        form.reset();
        form.action = '@Url.Action("AddSkills", "JobSeeker")';
        document.getElementById("oldCategoryName").value = "";
        document.getElementById("formTitle").innerHTML =
            '<i class="bi bi-plus-circle text-primary me-2"></i>Add New Skills';
        document.getElementById("submitBtn").innerHTML =
            '<i class="bi bi-plus-lg me-1"></i>Add Skills';
        document.getElementById("cancelEditBtn").classList.add("d-none");
    }
</script>
