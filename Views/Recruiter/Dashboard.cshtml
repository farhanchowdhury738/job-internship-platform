@model RecruiterDashboardViewModel
@{ ViewData["Title"] = "Recruiter Dashboard"; Layout = "_DashboardLayout"; var max = Model.WeeklyApplicants.Max(); var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="page-title">@Model.Company.Name</h1><p class="page-sub">Recruiter overview - manage jobs and candidates.</p></div>
    <a class="btn btn-primary-grad" asp-action="PostJob"><i class="bi bi-plus-lg me-2"></i>Post a job</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-primary"><i class="bi bi-briefcase"></i></span><div><div class="val">@Model.ActiveJobs</div><div class="lbl">Active jobs</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-info"><i class="bi bi-people"></i></span><div><div class="val">@Model.TotalApplicants</div><div class="lbl">Total applicants</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-success"><i class="bi bi-star"></i></span><div><div class="val">@Model.Shortlisted</div><div class="lbl">Shortlisted</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-warning"><i class="bi bi-eye"></i></span><div><div class="val">@Model.Views.ToString("N0")</div><div class="lbl">Job views</div></div></div></div>
</div>
<div class="row g-4">
    <div class="col-xl-7">
        <div class="card-panel mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2"><h5 class="mb-0">Applicants this week</h5><span class="tag tag-primary">Last 7 days</span></div>
            <div class="bars">
                @for (var i = 0; i < Model.WeeklyApplicants.Length; i++)
                {
                    <div class="bar"><b>@Model.WeeklyApplicants[i]</b><div style="height:@(Model.WeeklyApplicants[i] * 100 / max)%"></div><small>@days[i]</small></div>
                }
            </div>
        </div>
        <div class="table-wrap">
            <div class="table-head"><h5 class="mb-0 fs-6">Recent applicants</h5><a class="small fw-semibold" asp-action="Applicants">View all</a></div>
            <div class="table-responsive"><table class="table">
                <thead><tr><th>Candidate</th><th>Applied for</th><th>Match</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var a in Model.RecentApplicants)
                {
                    <tr>
                        <td><div class="d-flex align-items-center gap-2"><span class="avatar sm">@a.Initials</span><div><strong class="text-dark d-block">@a.ApplicantName</strong><small class="text-muted">@a.ApplicantTitle</small></div></div></td>
                        <td class="text-muted">@a.JobTitle</td>
                        <td><span class="match @(a.MatchScore >= 85 ? "hi" : a.MatchScore >= 75 ? "mid" : "lo")">@a.MatchScore%</span></td>
                        <td>@await Html.PartialAsync("_StatusBadge", a.Status)</td>
                    </tr>
                }
                </tbody></table></div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">Your job posts</h5><a class="small fw-semibold" asp-action="Jobs">Manage</a></div>
            @foreach (var j in Model.Jobs)
            {
                <div class="list-row">
                    <div class="logo sm" style="background:@j.CompanyColor">@j.CompanyInitials</div>
                    <div class="flex-grow-1 min-w-0"><div class="fw-semibold text-dark text-truncate">@j.Title</div><small class="text-muted">@j.Type - @j.ApplicantCount applicants</small></div>
                    <span class="status @UiHelper.GenericStatusClass(j.Status)">@j.Status</span>
                </div>
            }
        </div>
    </div>
</div>
