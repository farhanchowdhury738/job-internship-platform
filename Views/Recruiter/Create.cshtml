@model Job
@{
    ViewData["Title"] = "Post a Job";
}
<div class="mx-auto" style="max-width: 720px;">
    <a asp-action="Index" class="page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        Back to my jobs
    </a>

    <div class="panel fade-up">
        <div class="panel__head">
            <div>
                <h1 class="panel__title">Post a new job</h1>
                <p class="form-hint mb-0">Provide clear details to attract the right candidates.</p>
            </div>
            <span class="chip chip--brand">New listing</span>
        </div>

        <div class="panel__body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Job title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Junior .NET Developer" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="6" placeholder="Describe the role, responsibilities, and requirements."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Salary" class="form-label">Salary <span class="text-muted-soft fw-normal">(optional)</span></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="Salary" class="form-control" type="number" step="0.01" min="0" placeholder="e.g. 35000" />
                        </div>
                        <span asp-validation-for="Salary" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Location" class="form-label">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Dhaka / Remote" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8M7 3v5h8" /></svg>
                        Publish job
                    </button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
