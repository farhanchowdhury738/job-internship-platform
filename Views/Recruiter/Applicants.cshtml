@model ApplicantsViewModel
@{ ViewData["Title"] = "Applicants"; Layout = "_DashboardLayout"; }
<div class="mb-4"><h1 class="page-title">Applicants</h1><p class="page-sub">Review candidates and update their application status.</p></div>
<form method="get" class="d-flex flex-wrap gap-2 mb-4">
    <select name="jobId" class="form-select" style="max-width:300px" data-autosubmit>
        <option value="">All jobs</option>
        @foreach (var j in Model.Jobs) { <option value="@j.Id" selected="@(Model.JobId == j.Id)">@j.Title</option> }
    </select>
    <select name="status" class="form-select" style="max-width:200px" data-autosubmit>
        <option value="">All statuses</option>
        @foreach (var s in Enum.GetNames<ApplicationStatus>()) { <option value="@s" selected="@(Model.Status == s)">@s</option> }
    </select>
</form>
<div class="table-wrap">
    <div class="table-responsive"><table class="table">
        <thead><tr><th>Candidate</th><th>Applied for</th><th>Experience</th><th>Match</th><th>Applied</th><th>Status</th><th class="text-end">CV</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Items)
        {
            <tr>
                <td><div class="d-flex align-items-center gap-2"><span class="avatar sm">@a.Initials</span><div><strong class="text-dark d-block">@a.ApplicantName</strong><small class="text-muted">@a.Email</small></div></div>
                    <div class="mt-1">@foreach (var s in a.Skills.Take(3)) { <span class="tag tag-gray me-1">@s</span> }</div></td>
                <td class="text-muted">@a.JobTitle</td>
                <td class="text-muted">@(a.ExperienceYears == 0 ? "Fresher" : a.ExperienceYears + " yrs")</td>
                <td><span class="match @(a.MatchScore >= 85 ? "hi" : a.MatchScore >= 75 ? "mid" : "lo")">@a.MatchScore%</span></td>
                <td class="text-muted">@a.AppliedDate.ToString("dd MMM")</td>
                <td>
                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-1 align-items-center">
                        <input type="hidden" name="id" value="@a.Id" />
                        <select name="status" class="form-select form-select-sm" style="min-width:130px" data-autosubmit>
                            @foreach (var s in Enum.GetValues<ApplicationStatus>()) { <option value="@s" selected="@(a.Status == s)">@s</option> }
                        </select>
                    </form>
                </td>
                <td class="text-end"><a class="btn btn-sm btn-soft" href="#"><i class="bi bi-download me-1"></i>CV</a></td>
            </tr>
        }
        </tbody></table></div>
    @if (!Model.Items.Any()) { <div class="empty"><i class="bi bi-people"></i>No applicants match these filters.</div> }
</div>
