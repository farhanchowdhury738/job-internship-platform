@model IEnumerable<Job>
@{
    ViewData["Title"] = "My Jobs";
    var jobs = Model.ToList();
    var withSalary = jobs.Count(j => j.Salary.HasValue);
    var locations = jobs.Where(j => !string.IsNullOrWhiteSpace(j.Location)).Select(j => j.Location!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count();
}
<div class="section-head mt-0">
    <div>
        <h2>My job posts</h2>
        <p>Create and manage your job listings.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
        Post a job
    </a>
</div>

@if (!jobs.Any())
{
    <div class="empty-state fade-up">
        <div class="empty-state__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
        </div>
        <h3>You have not posted any jobs yet</h3>
        <p>Publish your first opening and start reaching candidates today.</p>
        <a asp-action="Create" class="btn btn-primary">Create your first job</a>
    </div>
}
else
{
    <div class="stat-grid">
        <div class="stat-card">
            <span class="stat-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
            </span>
            <div><b>@jobs.Count</b><span>Total posts</span></div>
        </div>
        <div class="stat-card">
            <span class="stat-card__icon stat-card__icon--mint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
            </span>
            <div><b>@withSalary</b><span>With salary</span></div>
        </div>
        <div class="stat-card">
            <span class="stat-card__icon stat-card__icon--amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            </span>
            <div><b>@locations</b><span>Locations</span></div>
        </div>
    </div>

    <div class="table-shell fade-up">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Job</th>
                        <th class="d-none d-md-table-cell">Location</th>
                        <th class="d-none d-sm-table-cell">Salary</th>
                        <th class="d-none d-lg-table-cell">Posted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in jobs)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="company-mark" style="width:38px;height:38px;font-size:.95rem;" aria-hidden="true">@(string.IsNullOrWhiteSpace(job.Title) ? "J" : job.Title.Trim()[..1].ToUpperInvariant())</span>
                                    <div>
                                        <div class="cell-strong">@job.Title</div>
                                        <div class="table-user__email d-md-none">@(string.IsNullOrWhiteSpace(job.Location) ? "—" : job.Location)</div>
                                    </div>
                                </div>
                            </td>
                            <td class="d-none d-md-table-cell cell-muted">
                                <span class="chip">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                                    @(string.IsNullOrWhiteSpace(job.Location) ? "—" : job.Location)
                                </span>
                            </td>
                            <td class="d-none d-sm-table-cell">
                                @if (job.Salary.HasValue)
                                {
                                    <span class="cell-strong">@job.Salary.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="cell-muted">Negotiable</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell cell-muted">@job.PostedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@job.Id" class="btn btn-soft btn-sm" title="View listing">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="2.5" /></svg>
                                    </a>
                                    <a asp-action="Update" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" /></svg>
                                        <span class="d-none d-sm-inline">Edit</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-danger btn-sm">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                                        <span class="d-none d-sm-inline">Delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
