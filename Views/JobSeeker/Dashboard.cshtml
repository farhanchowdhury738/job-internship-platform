@model SeekerDashboardViewModel
@{ ViewData["Title"] = "Dashboard"; Layout = "_DashboardLayout"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="page-title">Hello, @Model.Profile.FullName.Split(' ')[0] 👋</h1><p class="page-sub">Here is what is happening with your job search.</p></div>
    <a class="btn btn-primary-grad" asp-controller="Jobs" asp-action="Index"><i class="bi bi-search me-2"></i>Find jobs</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-primary"><i class="bi bi-send"></i></span><div><div class="val">@Model.TotalApplied</div><div class="lbl">Applications</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-info"><i class="bi bi-camera-video"></i></span><div><div class="val">@Model.Interviews</div><div class="lbl">Interviews</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-warning"><i class="bi bi-bookmark-heart"></i></span><div><div class="val">@Model.Saved</div><div class="lbl">Saved jobs</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card"><span class="ic tone-danger"><i class="bi bi-bell"></i></span><div><div class="val">@Model.Unread</div><div class="lbl">Unread alerts</div></div></div></div>
</div>
<div class="row g-4">
    <div class="col-xl-8">
        <div class="table-wrap mb-4">
            <div class="table-head"><h5 class="mb-0 fs-6">Recent applications</h5><a class="small fw-semibold" asp-action="Applications">View all</a></div>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Job</th><th>Applied</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.RecentApplications)
                    {
                        <tr>
                            <td><div class="d-flex align-items-center gap-3"><div class="logo sm" style="background:@a.CompanyColor">@a.CompanyInitials</div><div><a class="fw-semibold text-dark" asp-controller="Jobs" asp-action="Details" asp-route-id="@a.JobId">@a.JobTitle</a><div class="small text-muted">@a.CompanyName</div></div></div></td>
                            <td class="text-muted">@a.AppliedDate.ToString("dd MMM yyyy")</td>
                            <td>@await Html.PartialAsync("_StatusBadge", a.Status)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <h5 class="fs-6 mb-3">Recommended for you</h5>
        <div class="row g-3">@foreach (var j in Model.Recommended) { <div class="col-md-6 col-xxl-4">@await Html.PartialAsync("_JobCard", j)</div> }</div>
    </div>
    <div class="col-xl-4">
        <div class="card-panel profile-card mb-4">
            <div class="profile-cover"></div>
            <div class="body">
                <span class="avatar lg">SH</span>
                <h5 class="mt-3 mb-0">@Model.Profile.FullName</h5>
                <div class="text-muted small mb-3">@Model.Profile.Headline</div>
                <div class="d-flex justify-content-between small mb-1"><span>Profile completion</span><strong class="text-dark">@Model.Profile.Completion%</strong></div>
                <div class="progress mb-3"><div class="progress-bar" style="width:@Model.Profile.Completion%"></div></div>
                <a class="btn btn-soft w-100" asp-action="Profile">Complete profile</a>
            </div>
        </div>
        <div class="card-panel">
            <h5>Application tips</h5>
            <ul class="check-list small text-muted">
                <li><i class="bi bi-lightbulb"></i><span>Keep your CV updated with recent projects.</span></li>
                <li><i class="bi bi-lightbulb"></i><span>Add at least 5 skills to improve job matches.</span></li>
                <li><i class="bi bi-lightbulb"></i><span>Apply early - most jobs fill within two weeks.</span></li>
            </ul>
        </div>
    </div>
</div>
