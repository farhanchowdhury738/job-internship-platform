@model HireLink.Models.ViewModels.AdminJobListViewModel
@{
    ViewData["Title"] = "Manage Jobs";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Location);
}
<div class="section-head mt-0">
    <div>
        <h2>Manage jobs</h2>
        <p>Review, search, and remove job postings across the portal.</p>
    </div>
    <span class="chip chip--brand">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
        @Model.Jobs.TotalCount total
    </span>
</div>

<partial name="_AdminTabs" />

<form method="get" asp-action="Jobs" class="admin-toolbar" role="search">
    <div class="admin-toolbar__field admin-toolbar__field--grow">
        <label class="visually-hidden" for="jobSearch">Search jobs</label>
        <span class="admin-toolbar__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        </span>
        <input id="jobSearch" name="search" value="@Model.Search" class="form-control" type="search"
               placeholder="Search by job title, location, or recruiter…" />
    </div>

    <div class="admin-toolbar__field">
        <label class="visually-hidden" for="jobLocation">Location</label>
        <select id="jobLocation" name="location" class="form-select">
            <option value="">All locations</option>
            @foreach (var location in Model.Locations)
            {
                <option value="@location" selected="@(string.Equals(location, Model.Location, StringComparison.Ordinal))">@location</option>
            }
        </select>
    </div>

    <div class="admin-toolbar__actions">
        <button type="submit" class="btn btn-primary">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            Search
        </button>
        @if (hasFilters)
        {
            <a asp-action="Jobs" class="btn btn-light">Clear</a>
        }
    </div>
</form>

@if (Model.Jobs.TotalCount == 0)
{
    <div class="empty-state fade-up">
        <div class="empty-state__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
        </div>
        @if (hasFilters)
        {
            <h3>No jobs match your search</h3>
            <p>Try a different job title, recruiter name, or clear the location filter.</p>
            <a asp-action="Jobs" class="btn btn-light">Clear filters</a>
        }
        else
        {
            <h3>No jobs have been posted yet</h3>
            <p>Listings created by recruiters will appear here for review.</p>
        }
    </div>
}
else
{
    <div class="table-shell fade-up">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Job</th>
                        <th class="d-none d-md-table-cell">Recruiter</th>
                        <th class="d-none d-lg-table-cell">Location</th>
                        <th class="d-none d-sm-table-cell">Salary</th>
                        <th class="d-none d-md-table-cell">Posted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs.Items)
                    {
                        var mark = string.IsNullOrWhiteSpace(job.Title) ? "J" : job.Title.Trim()[..1].ToUpperInvariant();
                        <tr>
                            <td>
                                <div class="table-user">
                                    <span class="company-mark" style="width:38px;height:38px;font-size:.95rem;" aria-hidden="true">@mark</span>
                                    <div>
                                        <div class="table-user__name">@job.Title</div>
                                        <div class="table-user__email d-md-none">@job.RecruiterName · @(string.IsNullOrWhiteSpace(job.Location) ? "No location" : job.Location)</div>
                                        <div class="table-user__email d-none d-md-block">@(string.IsNullOrWhiteSpace(job.Location) ? "No location" : job.Location)</div>
                                    </div>
                                </div>
                            </td>
                            <td class="d-none d-md-table-cell">
                                <div class="cell-strong">@job.RecruiterName</div>
                                <div class="table-user__email">@job.RecruiterEmail</div>
                            </td>
                            <td class="d-none d-lg-table-cell cell-muted">
                                <span class="chip">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                                    @(string.IsNullOrWhiteSpace(job.Location) ? "—" : job.Location)
                                </span>
                            </td>
                            <td class="d-none d-sm-table-cell">
                                @if (job.Salary.HasValue)
                                {
                                    <span class="cell-strong">@job.Salary.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="cell-muted">Negotiable</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell cell-muted">@job.PostedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@job.Id" class="btn btn-soft btn-sm" title="View listing" aria-label="View @job.Title">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="2.5" /></svg>
                                    </a>
                                    <a asp-action="DeleteJob" asp-route-id="@job.Id" asp-route-search="@Model.Search"
                                       asp-route-location="@Model.Location" asp-route-returnPage="@Model.Jobs.Page"
                                       class="btn btn-danger btn-sm" aria-label="Delete @job.Title">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                                        <span class="d-none d-sm-inline">Delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_AdminPagination" model="Model.Pagination" />
}
