@model HireLink.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="section-head mt-0">
    <div>
        <h2>Admin dashboard</h2>
        <p>A live snapshot of the HireLink community, sourced directly from the database.</p>
    </div>
    <a asp-action="Jobs" class="btn btn-primary btn-sm">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
        Manage jobs
    </a>
</div>

<partial name="_AdminTabs" />

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11" /></svg>
        </span>
        <div><b>@Model.TotalUsers</b><span>Total users</span></div>
    </div>
    <div class="stat-card">
        <span class="stat-card__icon stat-card__icon--mint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
        </span>
        <div><b>@Model.TotalJobs</b><span>Total jobs</span></div>
    </div>
    <div class="stat-card">
        <span class="stat-card__icon stat-card__icon--amber">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-3V5a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z" /><path d="M2 12h20" /></svg>
        </span>
        <div><b>@Model.TotalRecruiters</b><span>Recruiters</span></div>
    </div>
    <div class="stat-card">
        <span class="stat-card__icon stat-card__icon--rose">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v6c0 4.4 3.4 7.4 8 8 4.6-.6 8-3.6 8-8V7l-8-4Z" /><circle cx="12" cy="11" r="2.5" /><path d="M12 13.5V16" /></svg>
        </span>
        <div><b>@Model.TotalAdmins</b><span>Admins</span></div>
    </div>
</div>

<div class="admin-split">
    <section class="panel fade-up" aria-labelledby="recentJobsTitle">
        <div class="panel__head">
            <h3 class="panel__title" id="recentJobsTitle">Recent jobs</h3>
            <a asp-action="Jobs" class="btn btn-soft btn-sm">View all</a>
        </div>

        @if (Model.RecentJobs.Count == 0)
        {
            <div class="panel__body">
                <div class="empty-state empty-state--compact">
                    <div class="empty-state__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
                    </div>
                    <h3>No jobs posted yet</h3>
                    <p>Job listings will appear here as soon as recruiters publish them.</p>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Job</th>
                            <th class="d-none d-md-table-cell">Recruiter</th>
                            <th class="d-none d-lg-table-cell">Location</th>
                            <th class="d-none d-sm-table-cell">Salary</th>
                            <th class="text-end">Posted</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.RecentJobs)
                        {
                            var mark = string.IsNullOrWhiteSpace(job.Title) ? "J" : job.Title.Trim()[..1].ToUpperInvariant();
                            <tr>
                                <td>
                                    <div class="table-user">
                                        <span class="company-mark" style="width:36px;height:36px;font-size:.9rem;" aria-hidden="true">@mark</span>
                                        <div>
                                            <div class="table-user__name">@job.Title</div>
                                            <div class="table-user__email d-md-none">@job.RecruiterName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell cell-muted">@job.RecruiterName</td>
                                <td class="d-none d-lg-table-cell cell-muted">
                                    @(string.IsNullOrWhiteSpace(job.Location) ? "—" : job.Location)
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    @if (job.Salary.HasValue)
                                    {
                                        <span class="cell-strong">@job.Salary.Value.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="cell-muted">Negotiable</span>
                                    }
                                </td>
                                <td class="text-end cell-muted">@job.PostedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <aside class="panel fade-up" aria-labelledby="communityTitle">
        <div class="panel__head">
            <h3 class="panel__title" id="communityTitle">Community</h3>
            <a asp-action="Users" class="btn btn-soft btn-sm">Manage</a>
        </div>
        <div class="panel__body">
            <dl class="info-list">
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                    <div>
                        <dt>Active accounts</dt>
                        <dd>@Model.ActiveUsers</dd>
                    </div>
                </div>
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                    </span>
                    <div>
                        <dt>Deactivated accounts</dt>
                        <dd>@Model.InactiveUsers</dd>
                    </div>
                </div>
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z" /><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5" /></svg>
                    </span>
                    <div>
                        <dt>Job seekers</dt>
                        <dd>@Model.TotalStudents</dd>
                    </div>
                </div>
            </dl>

            @if (Model.TotalUsers == 0)
            {
                <div class="empty-state empty-state--compact mt-3">
                    <h3>No users yet</h3>
                    <p>Registered accounts will be summarised here.</p>
                </div>
            }
            else
            {
                <p class="form-hint mt-3 mb-0">
                    Totals refresh on every page load using database queries.
                </p>
            }
        </div>
    </aside>
</div>
