@model Job
@{
    ViewData["Title"] = "Delete Job";
    var returnSearch = Context.Request.Query["search"].ToString();
    var returnLocation = Context.Request.Query["location"].ToString();
    var returnPage = int.TryParse(Context.Request.Query["returnPage"], out var p) ? p : 1;
    var recruiterName = Model.User?.Name ?? "Unknown recruiter";
}
<div class="mx-auto" style="max-width: 640px;">
    <a asp-action="Jobs" asp-route-search="@returnSearch" asp-route-location="@returnLocation" asp-route-page="@returnPage" class="page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        Back to job management
    </a>

    <div class="danger-panel fade-up">
        <div class="danger-panel__head">
            <span class="danger-panel__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /></svg>
            </span>
            <div>
                <h1 class="h5 fw-bold mb-1">Delete this job posting?</h1>
                <p class="mb-0 text-muted-soft small">
                    The listing is permanently removed. The recruiter account and their other jobs are not affected.
                </p>
            </div>
        </div>

        <div class="panel__body">
            <dl class="info-list mb-4">
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" /></svg>
                    </span>
                    <div>
                        <dt>Job title</dt>
                        <dd>@Model.Title</dd>
                    </div>
                </div>
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                    </span>
                    <div>
                        <dt>Recruiter</dt>
                        <dd>@recruiterName</dd>
                    </div>
                </div>
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                    </span>
                    <div>
                        <dt>Location</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Location) ? "Not specified" : Model.Location)</dd>
                    </div>
                </div>
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                    </span>
                    <div>
                        <dt>Salary</dt>
                        <dd>@(Model.Salary.HasValue ? Model.Salary.Value.ToString("N0") + " / month" : "Not specified")</dd>
                    </div>
                </div>
                <div class="info-list__item">
                    <span class="info-list__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                    </span>
                    <div>
                        <dt>Posted</dt>
                        <dd>@Model.PostedAt.ToString("dd MMM yyyy")</dd>
                    </div>
                </div>
            </dl>

            <form asp-action="DeleteJobConfirmed" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="returnSearch" value="@returnSearch" />
                <input type="hidden" name="returnLocation" value="@returnLocation" />
                <input type="hidden" name="returnPage" value="@returnPage" />
                <div class="form-actions mt-0">
                    <button type="submit" class="btn btn-danger" data-confirm-delete
                            data-confirm-message="Delete "@Model.Title"? This cannot be undone. The recruiter account and their other jobs are not affected.">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                        Yes, delete job
                    </button>
                    <a asp-action="Jobs" asp-route-search="@returnSearch" asp-route-location="@returnLocation" asp-route-page="@returnPage" class="btn btn-light">Keep job</a>
                </div>
            </form>
        </div>
    </div>
</div>
