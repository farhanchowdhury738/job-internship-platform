@model List<AppUser>
@{ ViewData["Title"] = "Manage Users"; Layout = "_DashboardLayout"; var role = (string?)ViewBag.Role; }
<div class="mb-4"><h1 class="page-title">Users</h1><p class="page-sub">Manage job seekers, recruiters and administrators.</p></div>
<div class="table-wrap">
    <div class="table-head">
        <div class="chip-tabs">
            <a asp-action="Users" class="@(string.IsNullOrEmpty(role) ? "active" : "")">All</a>
            @foreach (var r in new[] { "JobSeeker", "Recruiter", "Admin" }) { <a asp-action="Users" asp-route-role="@r" class="@(role == r ? "active" : "")">@r</a> }
        </div>
        <form method="get" class="input-icon" style="min-width:260px"><i class="bi bi-search"></i><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Search name or email" /><input type="hidden" name="role" value="@role" /></form>
    </div>
    <div class="table-responsive"><table class="table">
        <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Joined</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td><div class="d-flex align-items-center gap-2"><span class="avatar sm">@u.Initials</span><div><strong class="text-dark d-block">@u.Name</strong><small class="text-muted">@u.Email</small></div></div></td>
                <td><span class="tag @(u.Role == "Admin" ? "tag-intern" : u.Role == "Recruiter" ? "tag-green" : "tag-primary")">@u.Role</span></td>
                <td><span class="status @UiHelper.GenericStatusClass(u.Status)">@u.Status</span></td>
                <td class="text-muted">@u.Joined.ToString("dd MMM yyyy")</td>
                <td>
                    <form asp-action="Moderate" method="post" class="row-actions">
                        <input type="hidden" name="target" value="User" /><input type="hidden" name="id" value="@u.Id" /><input type="hidden" name="returnAction" value="Users" />
                        @if (u.Status == "Suspended") { <button class="btn btn-soft" name="act" value="Reactivated" title="Reactivate"><i class="bi bi-arrow-counterclockwise"></i></button> }
                        else { <button class="btn btn-outline-soft" name="act" value="Suspended" title="Suspend"><i class="bi bi-slash-circle"></i></button> }
                        <button class="btn btn-danger-soft" name="act" value="Deleted" title="Delete" onclick="return confirm('Delete this user?')"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        </tbody></table></div>
</div>
