@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-shell fade-up">
    <aside class="auth-aside">
        <div>
            <span class="eyebrow" style="color:#e0e7ff; background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.24);">
                <span class="dot"></span> Welcome back
            </span>
            <div class="auth-aside__body mt-4">
                <h2>Pick up where you left off.</h2>
                <p>Your saved searches, applications, and posted roles are waiting for you.</p>
                <ul class="auth-points">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        Track the latest openings
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        Manage your recruiter listings
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        Secure, cookie-based sessions
                    </li>
                </ul>
            </div>
        </div>
        <p class="small mb-0">HireLink · Connecting talent with opportunity</p>
    </aside>

    <div class="auth-form">
        <h1>Log in to HireLink</h1>
        <p class="lead">Enter your details to access your account.</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Log in
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
        </form>

        <div class="auth-divider">or</div>

        <p class="text-center text-muted-soft mb-0">
            New to HireLink? <a asp-action="Register" class="fw-semibold">Create an account</a>
        </p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
