@model LoginViewModel
@{ ViewData["Title"] = "Log in"; Layout = "_AuthLayout"; }
<a class="brand d-lg-none mb-4" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-briefcase-fill"></i></span>Job<span>Hub</span></a>
<h1>Welcome back</h1>
<p class="text-muted mb-4">Log in to continue your job search.</p>
<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="mb-3">
        <label class="form-label">I am a</label>
        <div class="role-switch">
            <div><input type="radio" id="r1" name="Role" value="JobSeeker" checked="@(Model.Role == "JobSeeker")" /><label for="r1"><i class="bi bi-person"></i>Job Seeker</label></div>
            <div><input type="radio" id="r2" name="Role" value="Recruiter" checked="@(Model.Role == "Recruiter")" /><label for="r2"><i class="bi bi-building"></i>Recruiter</label></div>
            <div><input type="radio" id="r3" name="Role" value="Admin" checked="@(Model.Role == "Admin")" /><label for="r3"><i class="bi bi-shield-check"></i>Admin</label></div>
        </div>
    </div>
    <div class="mb-3"><label class="form-label">Email</label><div class="input-icon"><i class="bi bi-envelope"></i><input class="form-control" type="email" name="Email" placeholder="you@example.com" /></div></div>
    <div class="mb-3">
        <label class="form-label d-flex justify-content-between">Password <a class="fw-normal small" asp-action="ForgotPassword">Forgot password?</a></label>
        <div class="input-icon"><i class="bi bi-lock"></i><input id="pw" class="form-control" type="password" name="Password" placeholder="Enter your password" /></div>
    </div>
    <div class="form-check mb-4"><input class="form-check-input" type="checkbox" name="RememberMe" value="true" id="rem" /><label class="form-check-label" for="rem">Remember me</label></div>
    <button class="btn btn-primary-grad w-100 btn-lg" type="submit">Log in</button>
</form>
<p class="text-center text-muted mt-4 mb-0">New to JobHub? <a asp-action="Register" class="fw-semibold">Create an account</a></p>
