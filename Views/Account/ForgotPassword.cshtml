@{ ViewData["Title"] = "Forgot password"; Layout = "_AuthLayout"; }
<div class="avatar lg mb-4"><i class="bi bi-key"></i></div>
<h1>Forgot password?</h1>
<p class="text-muted mb-4">Enter your email and we will send you a reset link.</p>
<form asp-action="ForgotPassword" method="post">
    <div class="mb-4"><label class="form-label">Email</label><div class="input-icon"><i class="bi bi-envelope"></i><input class="form-control" type="email" name="email" placeholder="you@example.com" required /></div></div>
    <button class="btn btn-primary-grad w-100 btn-lg" type="submit">Send reset link</button>
</form>
<p class="text-center mt-4 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Back to log in</a></p>
