@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="auth-shell fade-up">
    <aside class="auth-aside">
        <div>
            <span class="eyebrow" style="color:#e0e7ff; background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.24);">
                <span class="dot"></span> Join HireLink
            </span>
            <div class="auth-aside__body mt-4">
                <h2>Build your career, one connection at a time.</h2>
                <p>Create a free account as a job seeker or a recruiter and get started in seconds.</p>
                <ul class="auth-points">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        Free forever for job seekers
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        Post jobs in a couple of clicks
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        Transparent salary information
                    </li>
                </ul>
            </div>
        </div>
        <p class="small mb-0">HireLink · Connecting talent with opportunity</p>
    </aside>

    <div class="auth-form">
        <h1>Create your account</h1>
        <p class="lead">It only takes a minute to get started.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Full name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter your name" autocomplete="name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-2">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="Enter a password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label">Register as</label>
                <select asp-for="Role" class="form-select">
                    <option value="Student">Student / Job Seeker</option>
                    <option value="Recruiter">Recruiter</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
                <p class="form-hint mb-0">Recruiters can post and manage job listings.</p>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Create account
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
        </form>

        <div class="auth-divider">or</div>

        <p class="text-center text-muted-soft mb-0">
            Already registered? <a asp-action="Login" class="fw-semibold">Log in</a>
        </p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
