@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; Layout = "_AuthLayout"; }
<a class="brand d-lg-none mb-4" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-briefcase-fill"></i></span>Job<span>Hub</span></a>
<h1>Create your account</h1>
<p class="text-muted mb-4">It takes less than a minute.</p>
<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="mb-3">
        <label class="form-label">Register as</label>
        <div class="role-switch two">
            <div><input type="radio" id="rr1" name="Role" value="JobSeeker" checked="@(Model.Role != "Recruiter")" /><label for="rr1"><i class="bi bi-person"></i>Job Seeker</label></div>
            <div><input type="radio" id="rr2" name="Role" value="Recruiter" checked="@(Model.Role == "Recruiter")" /><label for="rr2"><i class="bi bi-building"></i>Recruiter</label></div>
        </div>
    </div>
    <div class="mb-3"><label class="form-label">Full name</label><div class="input-icon"><i class="bi bi-person"></i><input class="form-control" name="FullName" placeholder="Your full name" /></div></div>
    <div class="mb-3 d-none" id="companyBox"><label class="form-label">Company name</label><div class="input-icon"><i class="bi bi-building"></i><input class="form-control" name="CompanyName" placeholder="Your company" /></div></div>
    <div class="mb-3"><label class="form-label">Email</label><div class="input-icon"><i class="bi bi-envelope"></i><input class="form-control" type="email" name="Email" placeholder="you@example.com" /></div></div>
    <div class="row g-3 mb-3">
        <div class="col-sm-6"><label class="form-label">Password</label><input class="form-control" type="password" name="Password" placeholder="Min 8 characters" /></div>
        <div class="col-sm-6"><label class="form-label">Confirm</label><input class="form-control" type="password" name="ConfirmPassword" placeholder="Repeat password" /></div>
    </div>
    <div class="form-check mb-4"><input class="form-check-input" type="checkbox" id="terms" required /><label class="form-check-label small" for="terms">I agree to the <a asp-controller="Home" asp-action="Privacy">Terms &amp; Privacy Policy</a></label></div>
    <button class="btn btn-primary-grad w-100 btn-lg" type="submit">Create account</button>
</form>
<p class="text-center text-muted mt-4 mb-0">Already have an account? <a asp-action="Login" class="fw-semibold">Log in</a></p>
