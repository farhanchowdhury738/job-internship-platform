@if (TempData["Success"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:2000">
        <div class="toast app-toast show align-items-center border-0" role="alert" data-autohide="true">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-check-circle-fill text-success me-2"></i>@TempData["Success"]</div>
                <button type="button" class="btn-close me-3 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:2000" id="toastHost"></div>
