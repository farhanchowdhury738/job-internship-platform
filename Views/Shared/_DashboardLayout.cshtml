@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");
    string roleLabel = ctrl == "Admin" ? "Administrator" : ctrl == "Recruiter" ? "Recruiter" : "Job Seeker";
    string userName = ctrl == "Admin" ? "Admin Root" : ctrl == "Recruiter" ? "Karim Uddin" : "Sabbir Hasan";
    string initials = ctrl == "Admin" ? "AR" : ctrl == "Recruiter" ? "KU" : "SH";

    var menu = new List<(string Label, string Icon, string Action, string? Badge)>();
    if (ctrl == "Admin")
    {
        menu.Add(("Dashboard", "bi-grid-1x2", "Dashboard", null));
        menu.Add(("Users", "bi-people", "Users", null));
        menu.Add(("Companies", "bi-buildings", "Companies", null));
        menu.Add(("Job Posts", "bi-briefcase", "Jobs", null));
        menu.Add(("Reports", "bi-flag", "Reports", "3"));
        menu.Add(("Activity", "bi-activity", "Activity", null));
    }
    else if (ctrl == "Recruiter")
    {
        menu.Add(("Dashboard", "bi-grid-1x2", "Dashboard", null));
        menu.Add(("Company Profile", "bi-building", "CompanyProfile", null));
        menu.Add(("My Jobs", "bi-briefcase", "Jobs", null));
        menu.Add(("Post a Job", "bi-plus-circle", "PostJob", null));
        menu.Add(("Applicants", "bi-people", "Applicants", null));
        menu.Add(("Notifications", "bi-bell", "Notifications", "2"));
    }
    else
    {
        menu.Add(("Dashboard", "bi-grid-1x2", "Dashboard", null));
        menu.Add(("My Profile", "bi-person-vcard", "Profile", null));
        menu.Add(("Applications", "bi-send-check", "Applications", null));
        menu.Add(("Saved Jobs", "bi-bookmark-heart", "SavedJobs", null));
        menu.Add(("Notifications", "bi-bell", "Notifications", "2"));
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="dash">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <aside class="sidebar" id="sidebar">
        <a class="brand px-3 mb-4" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-briefcase-fill"></i></span>Job<span>Hub</span></a>
        <div class="sidebar-label">@roleLabel</div>
        <nav class="nav flex-column">
            @foreach (var m in menu)
            {
                var active = (act == m.Action || (m.Action == "PostJob" && act == "EditJob")) ? "active" : "";
                <a class="side-link @active" asp-controller="@ctrl" asp-action="@m.Action">
                    <i class="bi @m.Icon"></i><span>@m.Label</span>
                    @if (m.Badge != null) { <span class="badge-dot">@m.Badge</span> }
                </a>
            }
        </nav>
        <div class="sidebar-foot">
            <a class="side-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i><span>Back to site</span></a>
            <a class="side-link text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i><span>Log out</span></a>
        </div>
    </aside>

    <div class="dash-main">
        <header class="topbar">
            <button class="btn btn-icon d-lg-none" id="sidebarToggle" aria-label="Menu"><i class="bi bi-list fs-4"></i></button>
            <div class="topbar-search d-none d-md-flex">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search..." />
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                @if (ctrl != "Admin")
                {
                    <a class="btn btn-icon position-relative" asp-controller="@ctrl" asp-action="Notifications" aria-label="Notifications">
                        <i class="bi bi-bell"></i><span class="notif-dot"></span>
                    </a>
                }
                <div class="dropdown">
                    <a href="#" class="user-chip dropdown-toggle" data-bs-toggle="dropdown">
                        <span class="avatar">@initials</span>
                        <span class="d-none d-sm-block text-start lh-sm"><strong>@userName</strong><small class="d-block text-muted">@roleLabel</small></span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-soft border-0">
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Public site</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Log out</a></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="dash-content">
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_Toast")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
