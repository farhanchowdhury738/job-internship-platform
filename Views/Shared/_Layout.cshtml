@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string ActiveIf(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var displayName = User.Identity?.Name ?? "User";
    var initial = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Trim()[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HireLink — a modern job portal for students, job seekers, and recruiters." />
    <meta name="theme-color" content="#4f46e5" />
    <title>@ViewData["Title"] · HireLink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="hl-header" id="hlHeader">
        <div class="container">
            <nav class="hl-nav" aria-label="Main navigation">
                <a class="hl-brand" asp-controller="Home" asp-action="Index" aria-label="HireLink home">
                    <span class="hl-brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 4h6a2 2 0 0 1 2 2v2H7V6a2 2 0 0 1 2-2Z" />
                            <rect x="3" y="8" width="18" height="12" rx="3" />
                            <path d="M3 13h18" />
                        </svg>
                    </span>
                    <span class="hl-brand__text">Hire<span>Link</span></span>
                </a>

                <button class="hl-nav__toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <div class="collapse hl-nav__menu" id="mainNav">
                    <div class="hl-nav__links">
                        <a class="hl-link @ActiveIf("Home")" asp-controller="Home" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                            Jobs
                        </a>
                        @if (User.IsInRole("Recruiter"))
                        {
                            <a class="hl-link @ActiveIf("Recruiter")" asp-controller="Recruiter" asp-action="Index">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
                                My Jobs
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="hl-link @ActiveIf("Admin")" asp-controller="Admin" asp-action="Index">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v6c0 4.4 3.4 7.4 8 8 4.6-.6 8-3.6 8-8V7l-8-4Z" /><circle cx="12" cy="11" r="2.5" /><path d="M12 13.5V16" /></svg>
                                Admin
                            </a>
                        }
                    </div>

                    <div class="hl-nav__actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="hl-user">
                                <span class="hl-avatar" aria-hidden="true">@initial</span>
                                <span class="d-none d-sm-block">
                                    <span class="hl-user__name">@displayName</span>
                                    <span class="hl-user__role">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Recruiter") ? "Recruiter" : "Job Seeker")</span>
                                </span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-light btn-sm">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 17l5-5-5-5M20 12H9M12 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6" /></svg>
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                Get started
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="container hl-main">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success hl-flash mb-4" role="status">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <span>@TempData["Message"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger hl-flash mb-4" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
                <span>@TempData["Error"]</span>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="hl-footer">
        <div class="container">
            <div class="hl-footer__inner">
                <span class="hl-footer__brand">
                    <span class="hl-brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 4h6a2 2 0 0 1 2 2v2H7V6a2 2 0 0 1 2-2Z" />
                            <rect x="3" y="8" width="18" height="12" rx="3" />
                            <path d="M3 13h18" />
                        </svg>
                    </span>
                    HireLink
                </span>
                <span>© @DateTime.Now.Year HireLink. Connecting talent with opportunity.</span>
                <nav class="hl-footer__links" aria-label="Footer">
                    <a asp-controller="Home" asp-action="Index">Browse jobs</a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Register">Create account</a>
                    }
                </nav>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var header = document.getElementById('hlHeader');
            if (!header) return;
            var onScroll = function () {
                header.classList.toggle('is-scrolled', window.scrollY > 8);
            };
            onScroll();
            window.addEventListener('scroll', onScroll, { passive: true });

            var nav = document.getElementById('mainNav');
            if (nav) {
                nav.addEventListener('show.bs.collapse', function () {
                    header.classList.add('is-open');
                });
                nav.addEventListener('hidden.bs.collapse', function () {
                    header.classList.remove('is-open');
                });
            }
        })();

        // Single delegated confirmation handler for destructive admin actions.
        (function () {
            document.addEventListener('click', function (event) {
                var trigger = event.target.closest('[data-confirm-delete]');
                if (!trigger) return;

                var message = trigger.getAttribute('data-confirm-message')
                    || 'This action cannot be undone. Continue?';

                if (!window.confirm(message)) {
                    event.preventDefault();
                    event.stopPropagation();
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
