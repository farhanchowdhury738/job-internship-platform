@model HireLink.Models.ViewModels.PaginationInfo
@{
    if (Model.TotalPages <= 1)
    {
        return;
    }

    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, start + 4);
    start = Math.Max(1, end - 4);

    Dictionary<string, string> BuildRoute(int page)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var pair in Model.RouteValues)
        {
            if (!string.IsNullOrWhiteSpace(pair.Value))
            {
                values[pair.Key] = pair.Value!;
            }
        }

        values["page"] = page.ToString();
        return values;
    }
}
<nav class="admin-pagination" aria-label="Pagination">
    <span class="admin-pagination__summary">
        Showing <b>@(Math.Min((Model.Page - 1) * Model.PageSize + 1, Model.TotalCount))</b>–<b>@Math.Min(Model.Page * Model.PageSize, Model.TotalCount)</b>
        of <b>@Model.TotalCount</b>
    </span>

    <ul class="admin-pagination__list">
        <li>
            <a class="admin-pagination__link @(Model.Page <= 1 ? "disabled" : "")"
               asp-controller="@Model.Controller" asp-action="@Model.Action"
               asp-all-route-data="@BuildRoute(Model.Page - 1)"
               aria-label="Previous page" tabindex="@(Model.Page <= 1 ? "-1" : "0")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
            </a>
        </li>

        @if (start > 1)
        {
            <li>
                <a class="admin-pagination__link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="@BuildRoute(1)">1</a>
            </li>
            @if (start > 2)
            {
                <li><span class="admin-pagination__gap">…</span></li>
            }
        }

        @for (var i = start; i <= end; i++)
        {
            <li>
                <a class="admin-pagination__link @(i == Model.Page ? "active" : "")"
                   asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="@BuildRoute(i)"
                   aria-current="@(i == Model.Page ? "page" : null)">@i</a>
            </li>
        }

        @if (end < Model.TotalPages)
        {
            @if (end < Model.TotalPages - 1)
            {
                <li><span class="admin-pagination__gap">…</span></li>
            }
            <li>
                <a class="admin-pagination__link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="@BuildRoute(Model.TotalPages)">@Model.TotalPages</a>
            </li>
        }

        <li>
            <a class="admin-pagination__link @(Model.Page >= Model.TotalPages ? "disabled" : "")"
               asp-controller="@Model.Controller" asp-action="@Model.Action"
               asp-all-route-data="@BuildRoute(Model.Page + 1)"
               aria-label="Next page" tabindex="@(Model.Page >= Model.TotalPages ? "-1" : "0")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
            </a>
        </li>
    </ul>
</nav>
