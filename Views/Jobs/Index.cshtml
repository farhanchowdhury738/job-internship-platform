@model JobSearchViewModel
@{ ViewData["Title"] = "Find Jobs & Internships"; }
<div class="page-banner">
    <div class="container">
        <h1 class="mb-3">Find jobs &amp; internships</h1>
        <form method="get" asp-action="Index" class="search-bar">
            <div class="field"><i class="bi bi-search"></i><input type="text" name="Q" value="@Model.Q" placeholder="Job title, skill or company" /></div>
            <div class="field"><i class="bi bi-geo-alt"></i><input type="text" name="Location" value="@Model.Location" placeholder="Location" /></div>
            <input type="hidden" name="Type" value="@Model.Type" /><input type="hidden" name="Category" value="@Model.Category" /><input type="hidden" name="Level" value="@Model.Level" />
            <button class="btn btn-primary-grad btn-lg" type="submit">Search</button>
        </form>
    </div>
</div>
<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <form method="get" asp-action="Index" class="filter-card">
                <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="Location" value="@Model.Location" />
                <div class="d-flex justify-content-between align-items-center mb-3"><strong class="text-dark">Filters</strong><a class="small" asp-action="Index">Reset</a></div>
                <h6>Job type</h6>
                <select class="form-select" name="Type" data-autosubmit>
                    <option value="">All types</option>
                    @foreach (var t in new[] { "Full-time", "Part-time", "Internship", "Contract" })
                    { <option value="@t" selected="@(Model.Type == t)">@t</option> }
                </select>
                <h6>Category</h6>
                <select class="form-select" name="Category" data-autosubmit>
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    { <option value="@c" selected="@(Model.Category == c)">@c</option> }
                </select>
                <h6>Experience level</h6>
                <select class="form-select" name="Level" data-autosubmit>
                    <option value="">Any level</option>
                    @foreach (var l in new[] { "Entry", "Mid", "Senior" })
                    { <option value="@l" selected="@(Model.Level == l)">@l</option> }
                </select>
                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="remote" name="RemoteOnly" value="true" checked="@Model.RemoteOnly" data-autosubmit />
                    <label class="form-check-label" for="remote">Remote only</label>
                </div>
                <input type="hidden" name="Sort" value="@Model.Sort" />
            </form>
        </div>
        <div class="col-lg-9">
            <form method="get" asp-action="Index" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div><strong class="text-dark">@Model.Total</strong> <span class="text-muted">results found</span></div>
                <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="Location" value="@Model.Location" />
                <input type="hidden" name="Type" value="@Model.Type" /><input type="hidden" name="Category" value="@Model.Category" /><input type="hidden" name="Level" value="@Model.Level" />
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">Sort by</label>
                    <select class="form-select form-select-sm" name="Sort" style="width:auto" data-autosubmit>
                        <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                        <option value="salary" selected="@(Model.Sort == "salary")">Highest salary</option>
                        <option value="deadline" selected="@(Model.Sort == "deadline")">Deadline soon</option>
                        <option value="popular" selected="@(Model.Sort == "popular")">Most applied</option>
                    </select>
                </div>
            </form>
            @if (Model.Jobs.Any())
            {
                <div class="row g-4">
                    @foreach (var job in Model.Jobs)
                    { <div class="col-md-6">@await Html.PartialAsync("_JobCard", job)</div> }
                </div>
                @await Html.PartialAsync("_Pager", Model)
            }
            else
            {
                <div class="panel empty"><i class="bi bi-search"></i><h5>No jobs found</h5><p class="mb-3">Try adjusting your filters or search keywords.</p><a class="btn btn-soft" asp-action="Index">Clear filters</a></div>
            }
        </div>
    </div>
</div>
