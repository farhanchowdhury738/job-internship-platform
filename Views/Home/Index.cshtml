@model IEnumerable<Job>
@{
    ViewData["Title"] = "Find Jobs";
    var jobs = Model.ToList();
    var locations = jobs.Where(j => !string.IsNullOrWhiteSpace(j.Location))
                        .Select(j => j.Location!.Trim())
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .Count();
    var recruiters = jobs.Where(j => j.User != null).Select(j => j.User!.Id).Distinct().Count();
}
<section class="hero fade-up" aria-labelledby="heroTitle">
    <div class="hero__inner">
        <div>
            <span class="eyebrow"><span class="dot"></span> New opportunities every week</span>
            <h1 id="heroTitle">Find work that <em>fits your ambition</em></h1>
            <p>Discover hand-picked roles from trusted recruiters. Browse details, compare salaries, and take the next step in your career — all in one place.</p>
            <div class="hero__actions">
                <a href="#latest-jobs" class="btn btn-light btn-lg">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    Browse openings
                </a>
                @if (User.IsInRole("Recruiter"))
                {
                    <a asp-controller="Recruiter" asp-action="Create" class="btn btn-outline-light btn-lg">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                        Post a job
                    </a>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">Join HireLink</a>
                }
            </div>

            <div class="hero__stats">
                <div class="hero__stat">
                    <b>@jobs.Count</b>
                    <span>Open roles</span>
                </div>
                <div class="hero__stat">
                    <b>@locations</b>
                    <span>Locations</span>
                </div>
                <div class="hero__stat">
                    <b>@recruiters</b>
                    <span>Hiring teams</span>
                </div>
            </div>
        </div>

        <div class="hero__art" aria-hidden="true">
            <div class="hero__glass">
                <span class="hero__glass-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                </span>
                <div>
                    <b>Verified recruiters</b>
                    <span>Every listing reviewed</span>
                </div>
            </div>
            <div class="hero__glass">
                <span class="hero__glass-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                </span>
                <div>
                    <b>Transparent salaries</b>
                    <span>Know before you apply</span>
                </div>
            </div>
            <div class="hero__glass">
                <span class="hero__glass-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z" /></svg>
                </span>
                <div>
                    <b>Apply in minutes</b>
                    <span>No lengthy forms</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="section-head" id="latest-jobs">
    <div>
        <h2>Latest jobs <span class="section-head__count">@jobs.Count</span></h2>
        <p>Freshly posted roles from recruiters on HireLink.</p>
    </div>
    @if (User.IsInRole("Recruiter"))
    {
        <a asp-controller="Recruiter" asp-action="Create" class="btn btn-primary btn-sm">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
            Post a job
        </a>
    }
</div>

@if (!jobs.Any())
{
    <div class="empty-state fade-up">
        <div class="empty-state__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
        </div>
        <h3>No jobs posted yet</h3>
        <p>Be the first to publish an opening and reach talented candidates.</p>
        @if (User.IsInRole("Recruiter"))
        {
            <a asp-controller="Recruiter" asp-action="Create" class="btn btn-primary">Create the first job</a>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Join as a recruiter</a>
        }
    </div>
}
else
{
    <div class="row g-3 g-lg-4">
        @foreach (var job in jobs)
        {
            var company = job.User?.Name ?? "Recruiter";
            var mark = string.IsNullOrWhiteSpace(company) ? "H" : company.Trim()[..1].ToUpperInvariant();
            var location = string.IsNullOrWhiteSpace(job.Location) ? "Location not specified" : job.Location!;
            <div class="col-md-6 col-xl-4">
                <article class="job-card fade-up">
                    <div class="job-card__top">
                        <span class="company-mark" aria-hidden="true">@mark</span>
                        <span class="chip chip--mint">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                            Actively hiring
                        </span>
                    </div>

                    <h3 class="job-card__title">
                        <a asp-action="Details" asp-route-id="@job.Id">@job.Title</a>
                    </h3>

                    <div class="job-card__meta">
                        <span class="chip">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                            @location
                        </span>
                        <span class="chip">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                            @company
                        </span>
                    </div>

                    <p class="job-card__desc">@job.Description</p>

                    <div class="job-card__footer">
                        <span class="job-salary">
                            @(job.Salary.HasValue ? job.Salary.Value.ToString("N0") : "Negotiable")
                            <span>@(job.Salary.HasValue ? "per month" : "salary")</span>
                        </span>
                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm">
                            View details
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>
}
