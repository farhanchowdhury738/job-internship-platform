@model Job
@{
    ViewData["Title"] = Model.Title;
    var company = Model.User?.Name ?? "Recruiter";
    var mark = string.IsNullOrWhiteSpace(company) ? "H" : company.Trim()[..1].ToUpperInvariant();
    var location = string.IsNullOrWhiteSpace(Model.Location) ? "Location not specified" : Model.Location!;
}
<a asp-action="Index" class="page-back">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
    Back to jobs
</a>

<header class="detail-head fade-up">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-3">
            <span class="company-mark" aria-hidden="true" style="background: rgba(255,255,255,.16); border-color: rgba(255,255,255,.24); color:#fff;">@mark</span>
            <div>
                <span class="eyebrow" style="color:#e0e7ff; background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.24);">Job opening</span>
                <h1>@Model.Title</h1>
            </div>
        </div>
        <span class="chip chip--mint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            Actively hiring
        </span>
    </div>

    <div class="detail-meta mt-3">
        <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            @location
        </span>
        <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
            @company
        </span>
        <span class="chip">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            Posted @Model.PostedAt.ToString("dd MMM yyyy")
        </span>
    </div>
</header>

<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <section class="panel">
            <div class="panel__body">
                <p class="section-label">Job description</p>
                <div class="job-description">@Model.Description</div>
            </div>
        </section>
    </div>

    <aside class="col-lg-4">
        <div class="panel fade-up">
            <div class="panel__body">
                <p class="section-label">Overview</p>
                <dl class="info-list">
                    <div class="info-list__item">
                        <span class="info-list__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                        </span>
                        <div>
                            <dt>Salary</dt>
                            <dd>@(Model.Salary.HasValue ? Model.Salary.Value.ToString("N0") + " / month" : "Not specified")</dd>
                        </div>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                        </span>
                        <div>
                            <dt>Location</dt>
                            <dd>@location</dd>
                        </div>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                        </span>
                        <div>
                            <dt>Posted by</dt>
                            <dd>@company</dd>
                        </div>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M8 3v4M16 3v4M3 11h18" /></svg>
                        </span>
                        <div>
                            <dt>Date posted</dt>
                            <dd>@Model.PostedAt.ToString("dd MMMM yyyy")</dd>
                        </div>
                    </div>
                </dl>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-action="Index" class="btn btn-primary w-100 mt-4">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z" /></svg>
                        Browse more jobs
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary w-100 mt-4">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
                        Create an account to apply
                    </a>
                    <p class="form-hint text-center mt-2 mb-0">Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a></p>
                }
            </div>
        </div>
    </aside>
</div>
